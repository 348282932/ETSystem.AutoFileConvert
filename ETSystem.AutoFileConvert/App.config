<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!--默认只使用A账号转换,注释服务端账号-->
    <!--<add key="Account" value="15172177719" />-->
    <!--<add key="Password" value="whyh2022" />-->

    <!--转换类型授权（1为显示，0为隐藏），依次为 盗版、正版、DXF-->
    <add key="Format" value="1|1|1" />
  </appSettings>
</configuration>